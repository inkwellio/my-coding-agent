{
    "name": "my-coding-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Pi desktop coding agent — main workspace shell",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "cross-env ELECTRON_DEV=1 concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
        "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "start": "npm run build && electron .",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test:git": "node scripts/git-smoke.mjs",
        "test:mcp": "node scripts/mcp-smoke.mjs",
        "test:sandbox": "node scripts/sandbox-smoke.mjs",
        "test:sandbox:integration": "node scripts/sandbox-integration-smoke.mjs",
        "test:rpc-reconnect": "node scripts/rpc-reconnect-smoke.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sandbox-runtime": "0.0.78",
        "@earendil-works/pi-coding-agent": "^1.1.0",
        "marked": "18.0.11",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "electron": "^44.4.3",
        "postcss": "^8.5.28",
        "tailwindcss": "^3.4.19",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "wait-on": "^9.1.0"
    }
}
